# Linux counterpart to ops/com.klokie.seb-lunchmoney-sync.plist.
# Install: see ops/README.md. Edit HERE, not the copy under
# ~/.config/systemd/user/ — that one is overwritten on every reinstall.

[Unit]
Description=SEB -> Lunch Money sync (Enable Banking API)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Reuses bin/scheduled-sync.sh: it already does check + sync-all --commit +
# balances and honours these overrides, so nothing is reimplemented here.
# That script is zsh (print -r, setopt pipefail).
Environment=SEB_SYNC_REPO=%h/src/seb-lunchmoney-sync
Environment=SEB_SYNC_ENV=%h/.config/enablebanking/env
Environment=SEB_SYNC_LOG=%h/.local/state/seb-lunchmoney-sync.log
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/src/seb-lunchmoney-sync
ExecStart=/usr/bin/zsh %h/src/seb-lunchmoney-sync/bin/scheduled-sync.sh
